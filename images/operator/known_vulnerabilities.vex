{
  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "https://openvex.dev/docs/public/vex-sds-elastic-operator",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 1,
  "statements": [
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.53.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Advisory covers the unmaintained golang.org/x/crypto/openpgp subpackage. In the rook binary golang.org/x/crypto is pulled in transitively only for its pkcs12 package (pkg/daemon/ceph/osd/kms -> github.com/libopenstorage/secrets/azure -> github.com/Azure/azure-sdk-for-go/sdk/azidentity -> golang.org/x/crypto/pkcs12); `go mod why golang.org/x/crypto/openpgp` reports the main module does not need the openpgp package and `go list -deps ./cmd/rook` contains no openpgp package, so the vulnerable code is not compiled into the binary and is not in the execution path. golang.org/x/crypto has no release that drops openpgp, so the finding cannot be resolved by upgrading."
    }
  ],
  "timestamp": "2026-07-29T00:00:00Z"
}
